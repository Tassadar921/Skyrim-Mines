<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body { font-family: Georgia, serif; background: #f9f6f1; margin: 0; padding: 40px 20px; color: #1a1a1a; }
    .container { max-width: 560px; margin: 0 auto; background: #fff; border: 1px solid #e8e0d0; padding: 48px; }
    .logo { font-size: 13px; letter-spacing: 0.2em; text-transform: uppercase; color: #b45309; margin-bottom: 40px; }
    p { font-size: 15px; line-height: 1.7; color: #4a4a4a; margin: 0 0 16px; }
    .cta { display: block; width: fit-content; margin: 32px 0; padding: 14px 28px; background: #b45309; color: #fff !important; text-decoration: none; font-size: 14px; letter-spacing: 0.05em; }
    .footer { margin-top: 40px; padding-top: 24px; border-top: 1px solid #e8e0d0; font-size: 12px; color: #9a9a9a; }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">Consilium</div>

    <p>{{ greeting }}</p>
    <p>{{ body1 }}</p>
    <p>{{ body2 }}</p>

    <a href="{{ loginUrl }}" class="cta">{{ ctaLabel }}</a>

    <p>{{ ignore }}</p>

    <div class="footer">
      {{ footer }}<br><br>
      <a href="{{ legalUrl }}" style="color: #9a9a9a; text-decoration: underline;">{{ footerPrivacy }}</a>
    </div>
  </div>
</body>
</html>
