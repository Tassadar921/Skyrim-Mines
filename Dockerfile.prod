# =============================================================================
# Base
# =============================================================================
FROM node:24-alpine AS base
RUN npm install -g pnpm@latest
WORKDIR /app


# =============================================================================
# Stage 1a — Deps (toutes les dépendances, pour le build)
# =============================================================================
FROM base AS deps
# Filet de secours si le téléchargement du binaire précompilé de better-sqlite3 échoue/timeout :
# node-gyp peut alors compiler depuis les sources au lieu de faire échouer tout le build.
RUN apk add --no-cache python3 make g++
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install


# =============================================================================
# Stage 1b — Deps de production uniquement (pour l'image finale)
# =============================================================================
FROM base AS production-deps
RUN apk add --no-cache python3 make g++
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --prod


# =============================================================================
# Stage 2 — Build
# Compile TypeScript + Vite via node ace build
# =============================================================================
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
# Casse le cache Docker à partir d'ici, indépendamment du contenu copié (bug de cache Dokploy — https://github.com/Dokploy/dokploy/issues/2911)
ARG CACHEBUST=1
RUN echo "$CACHEBUST" > /dev/null
COPY . .
RUN node ace build --ignore-ts-errors


# =============================================================================
# Stage 3 — Production
# Image finale légère : build + deps de prod uniquement
# =============================================================================
FROM base AS runner

RUN addgroup -S app && adduser -S app -G app

ENV NODE_ENV=production

COPY --from=production-deps /app/node_modules ./node_modules
COPY --from=build /app/build .

RUN mkdir -p public/uploads && chown -R app:app /app
USER app

EXPOSE 8080

CMD ["sh", "-c", "node bin/server.js"]
